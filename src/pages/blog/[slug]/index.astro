---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import '../blog.css';
import { getPublishedPosts, formatDate } from '../../../utils/blog';

export async function getStaticPaths() {
  return (await getPublishedPosts()).map((post) => ({
    params: { slug: post.id }, props: { post },
  }));
}

interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { Content } = await render(post);
const canonicalUrl = new URL(`/blog/${post.id}/`, Astro.site!);
const image = new URL('og.png', canonicalUrl);
---

<Layout title={post.data.title} metadata={{
  description: post.data.title,
  canonicalUrl: canonicalUrl.href,
  image: image.href,
  type: 'article',
  publishedTime: post.data.date.toISOString(),
}}>
  <main>
    <a href="/blog/">back to blog</a>
    <article>
      <header>
        <h1>{post.data.title}</h1>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {post.data.tags.length > 0 && <p>{post.data.tags.map((tag) => `#${tag}`).join(' ')}</p>}
      </header>
      <Content />
    </article>
  </main>
</Layout>

