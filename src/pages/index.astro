---
import Layout from "../layouts/Layout.astro";
import "../layouts/reset.css";
import "./index.css";
import { getCollection } from "astro:content";
import ProfileCard from "../components/ProfileCard.astro";
import Projects from "../components/Projects.astro";
import { formatDate } from "../utils/blog";
import Webring from "../components/Webring.astro";
import Music from "../components/Music.astro";
const posts = (await getCollection("blog"))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .slice(0, 2);
---

<Layout title={"home"}>
    <div class="index">
        <div class="name">
            <h1 class="span">h</h1>

            <h1 class="span alternate">
                <span>tr</span>
            </h1>

            <h1 class="span">owii</h1>
        </div>
        <div class="thegrid">
            <div class="status">
                <ProfileCard />
            </div>
            <div class="blogposts">
                <h3>blogposts</h3>
                <div class="funnylayout1">
                    <div class="wrapper">
                        {posts.map((post) => (
                            <div class="blogpost">
                                <h5>
                                    <a href={`/blog/${post.id}/`}>
                                        {post.data.title}
                                    </a>
                                </h5>
                                <time datetime={post.data.date.toISOString()}>
                                    {formatDate(post.data.date)}
                                </time>
                            </div>
                        ))}
                    </div>
                    <div class="allposts">
                        <a href="/blog/">
                            <span>All</span>
                            <span class="posts">Posts</span>
                        </a>
                    </div>
                </div>
            </div>
            <div class="projects">
                <h3>projects &gt;</h3>
                <Projects />
            </div>
            <div class="links">
                <h3>findme</h3>
            </div>
            <div class="music">
                <!-- <h3>last_fm</h3> -->
                <Music />
            </div>
        </div>
    </div>
    <footer class="webring-footer">
        <Webring />
    </footer>
</Layout>
<script>
    const el = document.querySelector(".alternate");

    setInterval(() => {
        el.textContent = el.textContent === "tr" ? "rt" : "tr";
    }, 1000);
</script>
