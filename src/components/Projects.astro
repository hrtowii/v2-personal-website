---
import ProjectItem from "./ProjectItem.astro";
import ProjectVine from "./ProjectVine.astro";
import { projectdata } from "../data/projects";
import "./Projects.css";

// Repeat the text placement: left, right, narrow right, right, left.
const placements = ["left", "right", "narrow-right", "right", "left"] as const;
const projects = projectdata.flatMap((group) =>
    group.projects.map((project) => ({ project, category: group.title })),
);
const sections = [
    {
        title: "cool!",
        compact: false,
        projects: projects.filter(({ project }) => project.important === true),
    },
    {
        title: "others",
        compact: true,
        projects: projects.filter(({ project }) => project.important !== true),
    },
];
---

<div>
    {sections.map((section) => (
        <details class="project-group" open={!section.compact}>
            <summary>
                <h4>{section.title}</h4>
                <span class="project-marker" aria-hidden="true">
                    &gt;
                </span>
            </summary>
            <div
                class:list={[
                    "project-list",
                    { "project-list--compact": section.compact },
                ]}
                data-vine-host={!section.compact}
            >
                {!section.compact && <ProjectVine />}
                {section.projects.map(({ project, category }, index) => (
                    <ProjectItem
                        project={project}
                        category={category}
                        compact={section.compact}
                        placement={placements[index % placements.length]}
                    />
                ))}
            </div>
        </details>
    ))}
</div>
