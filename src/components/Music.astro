---
import "./Music.css";
import DitheredImage from "./DitheredImage.astro";
---

<section class="lastfm">
    <DitheredImage class="lastfm-art" alt="music album art" vines />
    <h3>music</h3>
    <ul></ul>
    <a class="lastfm-link" href="https://last.fm/u/htrowii">
        my lastfm
    </a>
</section>

<script>
    const LASTFM_USER = "htrowii";
    const LASTFM_API_KEY = "7a6a9d9af3a543d82266d8f0ff110f2c";

    interface LastfmTrack {
        name: string;
        url: string;
        artist: { "#text": string };
        image?: { "#text": string; size: string }[];
        "@attr"?: { nowplaying?: string };
    }

    async function loadTracks(section: HTMLElement) {
        try {
            const response = await fetch(
                `https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&user=${LASTFM_USER}&api_key=${LASTFM_API_KEY}&format=json&limit=5`,
            );
            if (!response.ok)
                throw new Error(`Last.fm request failed: ${response.status}`);

            const data = await response.json();
            const tracks: LastfmTrack[] = data.recenttracks?.track ?? [];
            const list = section.querySelector("ul")!;

            list.replaceChildren(
                ...tracks.map((track) => {
                    const item = document.createElement("li");
                    const link = document.createElement("a");
                    link.href = track.url;
                    link.textContent = track.name;
                    item.append(link, ` — ${track.artist["#text"]}`);
                    if (track["@attr"]?.nowplaying === "true")
                        item.append(" (playing)");
                    return item;
                }),
            );

            const currentTrack = tracks.find(
                (track) => track["@attr"]?.nowplaying === "true",
            );
            const selectedTrack = currentTrack ?? tracks[0];
            const getCover = (track?: LastfmTrack) =>
                track?.image?.findLast((image) => image["#text"])?.["#text"];
            const cover = getCover(selectedTrack) ?? tracks.map(getCover).find(Boolean);
            if (!cover) return;

            section.querySelector("dithered-image")!.setAttribute("src", cover);
        } catch (error) {
            console.error(error);
        }
    }

    const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
            if (entry.isIntersecting) {
                observer.unobserve(entry.target);
                void loadTracks(entry.target as HTMLElement);
            }
        }
    });

    document.querySelectorAll<HTMLElement>(".lastfm").forEach((section) => {
        observer.observe(section);
    });
</script>
