---
import "./ProfileCard.css";
---

<div class="pfp_wrapper">
  <img class="pfp" height={250} width={250} alt="User avatar" hidden />
  <p class="discord-status"></p>
  <div class="discord-activities"></div>
</div>

<script>
  import { dither } from "../utils/dither";

  const DISCORD_ID = "413331641109446656";

  interface DiscordUser {
    avatar: string | null;
  }

  interface DiscordActivity {
    type: number;
    name: string;
    details?: string | null;
    state?: string | null;
    emoji?: { name: string } | null;
  }

  interface DiscordPresence {
    discord_user: DiscordUser;
    discord_status: "online" | "idle" | "dnd" | "offline";
    activities: DiscordActivity[];
  }

  interface LanyardSuccess {
    success: true;
    data: DiscordPresence;
  }

  interface LanyardError {
    success: false;
    error: { code: string; message: string };
  }

  async function loadProfile(card: HTMLElement) {
    try {
      const response = await fetch(`https://api.lanyard.rest/v1/users/${DISCORD_ID}`);
      if (!response.ok) throw new Error(`Lanyard request failed: ${response.status}`);

      const result: LanyardSuccess | LanyardError = await response.json();
      if (!result.success) throw new Error(result.error.message);

      const { data } = result;
      card.querySelector(".discord-status")!.textContent = data.discord_status;

      const activities = data.activities
        .filter(({ name }) => name.toLowerCase() !== "spotify")
        .map(({ type, name, details, state, emoji }) =>
          [type === 4 ? emoji?.name : name, details, state].filter(Boolean).join(" — ")
        )
        .filter(Boolean);

      card.querySelector(".discord-activities")!.replaceChildren(
        ...activities.map((activity) => {
          const span = document.createElement("span");
          span.className = "discord-status";
          span.textContent = activity;
          return span;
        }),
      );

      const hash = data.discord_user.avatar;
      if (!hash) return;

      const image = new Image();
      image.crossOrigin = "anonymous";
      image.onload = () => {
        try {
          const art = dither(image);
          if (!art) return;

          const avatar = card.querySelector<HTMLImageElement>(".pfp")!;
          avatar.src = art;
          avatar.hidden = false;
        } catch (error) {
          console.error(error);
        }
      };
      image.src = `https://cdn.discordapp.com/avatars/${DISCORD_ID}/${hash}.png?size=512`;
    } catch (error) {
      console.error(error);
    }
  }

  document.querySelectorAll<HTMLElement>(".pfp_wrapper").forEach((card) => {
    void loadProfile(card);
  });
</script>
