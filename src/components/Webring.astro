---

{[webring_links, badge_links].map((items) => (
    <div class="webring-row">
        <div class="webring-track">
            {Array.from({ length: 3 }, (_, copy) => (
                <div class="webring-group">
                    {items.map(({ href, src, alt }) => (
                        <a href={href} tabindex={copy > 0 ? -1 : undefined}>
                            <img
                                src={src}
                                alt={alt ?? href}
                                width={88}
                                height={31}
                            />
                        </a>
                    ))}
                </div>
            ))}
        </div>
    </div>
))}

<div class="petring">
    <div class="petring_logo">
        <a href="https://webring.pet">
            <img
                src="https://webring.pet/petring-button-midnight.png"
                alt="Petring"
            />
        </a>
    </div>
    <div class="petring_buttons">
        <div class="petring_button">
            <a href="https://webring.pet/user/htrowii/prev">
                <p>&lang; previous!</p>
            </a>
        </div>
        <div class="petring_button">
            <a href="https://webring.pet/user/htrowii/random">
                <p>&suphsub; random!</p>
            </a>
