---
import type { ComponentProps } from 'astro/types';
import Metadata from '../components/Metadata.astro';

interface Props {
    title: string;
    metadata?: Omit<ComponentProps<typeof Metadata>, 'title'>;
}

const { title, metadata } = Astro.props;
import "./reset.css";
import "./fonts.css";
import "./layout.css";
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Xanh+Mono:ital@0;1&display=swap" rel="stylesheet">

        {metadata && <Metadata title={title} {...metadata} />}
	<title>{title + ' | hrtowii.nekoweb.org'}</title>
    </head>
    <body>
        <div class="container">
            <slot />
        </div>
    </body>
</html>
